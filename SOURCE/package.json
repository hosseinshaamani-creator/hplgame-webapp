{
  "name": "hplgame-webapp",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "preview": "node scripts/serve.mjs dist",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/prototype.test.mjs tests/demo-ui.test.mjs tests/week4.test.mjs tests/week5.test.mjs tests/learning-database.test.mjs tests/signup-groups.test.mjs tests/week6.test.mjs",
    "test:unit": "node --test tests/model.test.mjs tests/game.test.mjs tests/numbers.test.mjs tests/learning-store.test.mjs",
    "test:live": "node --test tests/supabase.integration.mjs",
    "test:ci": "node --test --test-reporter=spec tests/*.test.mjs",
    "prepare:pages": "node scripts/prepare-pages.mjs"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2"
  }
}
